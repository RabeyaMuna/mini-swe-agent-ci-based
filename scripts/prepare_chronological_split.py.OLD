"""
prepare_chronological_split.py
================================
Create chronological memory/eval split to prevent temporal data leakage.

This script:
1. Loads commit timestamps (from analyze_temporal_leakage.py output)
2. Sorts issues chronologically
3. Splits into memory (earliest) and eval (latest) sets
4. Saves the split with temporal guarantees

Usage:
    python scripts/prepare_chronological_split.py \
        --timestamps data/trs/commit_timestamps.json \
        --output-dir data/trs_chronological \
        --memory-ratio 0.3 \
        --strategy pure
"""

import json
import logging
from collections import defaultdict
from datetime import datetime
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

import typer
from datasets import load_dataset
from rich.console import Console
from rich.table import Table

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)
console = Console()

app = typer.Typer()


def _parse_timestamp(ts_str: Optional[str]) -> Optional[datetime]:
    """Parse ISO timestamp string to datetime."""
    if not ts_str:
        return None
    try:
        return datetime.fromisoformat(ts_str.replace('Z', '+00:00'))
    except Exception:
        return None


def _load_timestamps(timestamp_file: Path) -> Dict[str, Dict[str, Any]]:
    """Load commit timestamps from cache file."""
    console.print(f"[cyan]Loading timestamps from: {timestamp_file}[/cyan]")
    with open(timestamp_file, 'r') as f:
        timestamps = json.load(f)
    console.print(f"[green]Loaded timestamps for {len(timestamps)} issues[/green]")
    return timestamps


def _load_issues_from_hf(
    dataset_name: str = "ci-benchmark-user/ci-repair-bench",
    repo_filter: Optional[List[str]] = None,
) -> List[Dict[str, Any]]:
    """Load issues from HuggingFace dataset."""
    console.print(f"[cyan]Loading dataset: {dataset_name}[/cyan]")
    ds = load_dataset(dataset_name)
    data = ds["train"]

    issues = [dict(item) for item in data]

    if repo_filter:
        filtered = []
        for issue in issues:
            repo = f"{issue.get('repo_owner')}/{issue.get('repo_name')}".lower()
            if any(f.lower() in repo for f in repo_filter):
                filtered.append(issue)
        console.print(
            f"[green]Filtered to {len(filtered)} issues "
            f"(from {len(issues)} total)[/green]"
        )
        return filtered

    console.print(f"[green]Loaded {len(issues)} issues[/green]")
    return issues


def _augment_issues_with_timestamps(
    issues: List[Dict[str, Any]],
    timestamps: Dict[str, Dict[str, Any]],
) -> List[Dict[str, Any]]:
    """Add timestamp field to each issue."""
    augmented = []
    missing_count = 0

    for issue in issues:
        issue_id = str(issue.get('id'))
        ts_data = timestamps.get(issue_id)

        if ts_data and ts_data.get('timestamp'):
            # Add timestamp to issue
            issue['commit_timestamp'] = ts_data['timestamp']
            augmented.append(issue)
        else:
            missing_count += 1
            logger.warning(f"No timestamp for issue {issue_id}")

    console.print(
        f"[yellow]Missing timestamps: {missing_count}/{len(issues)}[/yellow]"
    )

    return augmented


def _chronological_split_pure(
    issues: List[Dict[str, Any]],
    memory_ratio: float = 0.3,
) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]]]:
    """
    Pure chronological split.

    Strategy:
    - Sort all issues by timestamp (ascending)
    - Take earliest X% as memory
    - Take remaining as eval

    Guarantees: All memory issues are older than all eval issues
    """
    console.print("[cyan]Performing pure chronological split...[/cyan]")

    # Sort by timestamp
    sorted_issues = sorted(
        issues,
        key=lambda x: _parse_timestamp(x.get('commit_timestamp'))
    )

    # Split
    cutoff_idx = max(1, int(len(sorted_issues) * memory_ratio))
    memory_set = sorted_issues[:cutoff_idx]
    eval_set = sorted_issues[cutoff_idx:]

    console.print(f"[green]Split: {len(memory_set)} memory, {len(eval_set)} eval[/green]")

    # Validate
    memory_latest = _parse_timestamp(memory_set[-1]['commit_timestamp'])
    eval_earliest = _parse_timestamp(eval_set[0]['commit_timestamp'])

    console.print(f"  Memory latest: {memory_latest.date()}")
    console.print(f"  Eval earliest: {eval_earliest.date()}")

    if memory_latest >= eval_earliest:
        console.print("[red]Warning: Temporal overlap detected![/red]")
    else:
        days_gap = (eval_earliest - memory_latest).days
        console.print(f"  [green]Gap: {days_gap} days (no overlap)[/green]")

    return memory_set, eval_set


def _chronological_split_per_repo(
    issues: List[Dict[str, Any]],
    memory_ratio: float = 0.3,
) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]]]:
    """
    Chronological split per repository.

    Strategy:
    - Group issues by repository
    - Within each repo, sort by timestamp
    - Take earliest X% as memory, rest as eval
    - Combine across repos

    Guarantees: Within each repo, no temporal leakage
    """
    console.print("[cyan]Performing per-repo chronological split...[/cyan]")

    # Group by repo
    repo_groups = defaultdict(list)
    for issue in issues:
        repo = f"{issue.get('repo_owner')}/{issue.get('repo_name')}"
        repo_groups[repo].append(issue)

    memory_set = []
    eval_set = []

    # Split each repo chronologically
    console.print(f"\n[cyan]Splitting {len(repo_groups)} repositories:[/cyan]")

    for repo, repo_issues in sorted(repo_groups.items()):
        # Sort by timestamp
        sorted_issues = sorted(
            repo_issues,
            key=lambda x: _parse_timestamp(x.get('commit_timestamp'))
        )

        # Split
        cutoff_idx = max(1, int(len(sorted_issues) * memory_ratio))
        repo_memory = sorted_issues[:cutoff_idx]
        repo_eval = sorted_issues[cutoff_idx:]

        memory_set.extend(repo_memory)
        eval_set.extend(repo_eval)

        # Show per-repo stats
        mem_dates = [_parse_timestamp(i['commit_timestamp']) for i in repo_memory]
        eval_dates = [_parse_timestamp(i['commit_timestamp']) for i in repo_eval]

        console.print(
            f"  {repo}: "
            f"{len(repo_memory)}M / {len(repo_eval)}E | "
            f"M:[{min(mem_dates).date()} to {max(mem_dates).date()}] "
            f"E:[{min(eval_dates).date()} to {max(eval_dates).date()}]"
        )

    console.print(
        f"\n[green]Total: {len(memory_set)} memory, {len(eval_set)} eval[/green]"
    )

    return memory_set, eval_set


def _save_split(
    memory_set: List[Dict[str, Any]],
    eval_set: List[Dict[str, Any]],
    output_dir: Path,
    strategy: str,
):
    """Save memory and eval sets."""
    output_dir.mkdir(parents=True, exist_ok=True)

    # Save full issues
    memory_path = output_dir / "memory_set.jsonl"
    with open(memory_path, 'w') as f:
        for issue in memory_set:
            f.write(json.dumps(issue) + '\n')
    console.print(f"[green]Saved memory set: {memory_path}[/green]")

    eval_path = output_dir / "eval_set.jsonl"
    with open(eval_path, 'w') as f:
        for issue in eval_set:
            f.write(json.dumps(issue) + '\n')
    console.print(f"[green]Saved eval set: {eval_path}[/green]")

    # Save IDs only
    memory_ids = [str(i.get('id')) for i in memory_set]
    eval_ids = [str(i.get('id')) for i in eval_set]

    memory_ids_path = output_dir / "memory_issue_ids.json"
    with open(memory_ids_path, 'w') as f:
        json.dump(memory_ids, f, indent=2)

    eval_ids_path = output_dir / "eval_issue_ids.json"
    with open(eval_ids_path, 'w') as f:
        json.dump(eval_ids, f, indent=2)

    # Metadata
    memory_dates = [_parse_timestamp(i['commit_timestamp']) for i in memory_set]
    eval_dates = [_parse_timestamp(i['commit_timestamp']) for i in eval_set]

    metadata = {
        "strategy": strategy,
        "total_issues": len(memory_set) + len(eval_set),
        "memory_set_size": len(memory_set),
        "eval_set_size": len(eval_set),
        "memory_ratio": len(memory_set) / (len(memory_set) + len(eval_set)),
        "memory_date_range": {
            "earliest": min(memory_dates).isoformat(),
            "latest": max(memory_dates).isoformat(),
        },
        "eval_date_range": {
            "earliest": min(eval_dates).isoformat(),
            "latest": max(eval_dates).isoformat(),
        },
        "temporal_leakage": "NONE (guaranteed by chronological split)",
    }

    metadata_path = output_dir / "split_metadata.json"
    with open(metadata_path, 'w') as f:
        json.dump(metadata, f, indent=2)
    console.print(f"[green]Saved metadata: {metadata_path}[/green]")


def _validate_split(
    memory_set: List[Dict[str, Any]],
    eval_set: List[Dict[str, Any]],
) -> Dict[str, Any]:
    """
    Validate that the split has no temporal leakage.

    Returns validation report.
    """
    console.print("\n[cyan]Validating temporal guarantees...[/cyan]")

    # Group by repo
    memory_by_repo = defaultdict(list)
    eval_by_repo = defaultdict(list)

    for issue in memory_set:
        repo = f"{issue.get('repo_owner')}/{issue.get('repo_name')}"
        dt = _parse_timestamp(issue.get('commit_timestamp'))
        if dt:
            memory_by_repo[repo].append(dt)

    for issue in eval_set:
        repo = f"{issue.get('repo_owner')}/{issue.get('repo_name')}"
        dt = _parse_timestamp(issue.get('commit_timestamp'))
        if dt:
            eval_by_repo[repo].append(dt)

    # Check for leakage per repo
    violations = []

    for repo in set(memory_by_repo.keys()) | set(eval_by_repo.keys()):
        mem_dates = memory_by_repo.get(repo, [])
        eval_dates = eval_by_repo.get(repo, [])

        if not mem_dates or not eval_dates:
            continue

        # Check if any memory is newer than any eval
        latest_memory = max(mem_dates)
        earliest_eval = min(eval_dates)

        if latest_memory >= earliest_eval:
            violations.append({
                'repo': repo,
                'latest_memory': latest_memory.isoformat(),
                'earliest_eval': earliest_eval.isoformat(),
                'overlap_days': (latest_memory - earliest_eval).days,
            })

    if violations:
        console.print(f"[red]Found {len(violations)} temporal violations![/red]")
        for v in violations:
            console.print(f"  {v['repo']}: overlap of {v['overlap_days']} days")
    else:
        console.print("[green]✓ No temporal leakage detected[/green]")

    return {
        'valid': len(violations) == 0,
        'violations': violations,
    }


@app.command()
def main(
    timestamps: Path = typer.Option(
        "data/trs/commit_timestamps.json",
        help="Path to commit timestamps JSON (from analyze_temporal_leakage.py)",
    ),
    output_dir: Path = typer.Option(
        "data/trs_chronological",
        help="Output directory for chronological split",
    ),
    memory_ratio: float = typer.Option(
        0.3,
        help="Ratio of issues to use for memory (0.0-1.0)",
    ),
    strategy: str = typer.Option(
        "per-repo",
        help="Split strategy: 'pure' (global) or 'per-repo' (within each repo)",
    ),
    repos: Optional[str] = typer.Option(
        None,
        help="Filter by repo names (comma-separated, e.g., 'agno,flower')",
    ),
    dataset_name: str = typer.Option(
        "ci-benchmark-user/ci-repair-bench",
        help="HuggingFace dataset name",
    ),
):
    """
    Create chronological memory/eval split to prevent temporal leakage.
    """
    console.print("[bold cyan]Chronological Memory/Eval Split[/bold cyan]\n")

    # Parse repo filter
    repo_filter = [r.strip() for r in repos.split(',')] if repos else None

    # Load timestamps
    timestamp_data = _load_timestamps(timestamps)

    # Load issues
    issues = _load_issues_from_hf(dataset_name, repo_filter)

    # Augment with timestamps
    issues_with_ts = _augment_issues_with_timestamps(issues, timestamp_data)

    if len(issues_with_ts) < len(issues):
        console.print(
            f"[yellow]Warning: Only {len(issues_with_ts)}/{len(issues)} "
            f"issues have timestamps[/yellow]"
        )

    # Perform split
    if strategy == 'pure':
        memory_set, eval_set = _chronological_split_pure(
            issues_with_ts, memory_ratio
        )
    elif strategy == 'per-repo':
        memory_set, eval_set = _chronological_split_per_repo(
            issues_with_ts, memory_ratio
        )
    else:
        console.print(f"[red]Unknown strategy: {strategy}[/red]")
        raise typer.Exit(1)

    # Validate
    validation = _validate_split(memory_set, eval_set)

    # Save
    _save_split(memory_set, eval_set, output_dir, strategy)

    # Summary
    console.print("\n[bold green]Chronological Split Complete![/bold green]")
    console.print(f"Strategy: {strategy}")
    console.print(f"Memory: {len(memory_set)} issues")
    console.print(f"Eval: {len(eval_set)} issues")
    console.print(f"Output: {output_dir}")

    if validation['valid']:
        console.print("\n[green]✓ Temporal guarantees validated[/green]")
    else:
        console.print(f"\n[red]⚠ {len(validation['violations'])} validation errors[/red]")

    console.print("\n[bold]Next steps:[/bold]")
    console.print("1. Update your evaluation scripts to use the new split")
    console.print("2. Add temporal filtering in memory retrieval:")
    console.print("   - Only retrieve memory with timestamp < eval_issue.timestamp")
    console.print("3. Re-run evaluations and compare with similarity-based split")


if __name__ == "__main__":
    app()
